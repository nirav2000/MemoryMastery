rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isOwner() { return signedIn() && request.auth.token.email == 'myaeixa@gmail.com'; }
    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);
      match /{collection}/{document=**} {
        allow read, create, update, delete: if owns(uid);
      }
    }
    match /publicCurriculum/{document=**} { allow read: if true; allow write: if false; }
    match /appConfig/designOverrides {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
